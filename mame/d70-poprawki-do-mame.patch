+std::string roland_d70_state::target_name(int t)
+{
+	const learn_target &lt = s_learn_targets[t];
+	switch (lt.type)
+	{
+	case LT_BUTTON:
+		for (ioport_field &f : m_keys[lt.port]->fields())
+			if (f.mask() == lt.mask)
+				return f.name();
+		break;
+	case LT_ANALOG:
+		if (ioport_field *f = analog_port(lt.port).fields().first())
+			return f->name();
+		break;
+	case LT_DIAL:     return "VALUE";
+	case LT_DIAL_DEC: return m_lang_pl ? "VALUE (w lewo)" : "VALUE (left)";
+	case LT_DIAL_INC: return m_lang_pl ? "VALUE (w prawo)" : "VALUE (right)";
+	}
