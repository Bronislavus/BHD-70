+// Called by the MIDI input for every complete channel message. Returns true if
+// the message was used by MIDI learn (then the firmware does not get it).
+bool roland_d70_state::midi_filter(const u8 *msg, int len)
+{
+	const u8 type = msg[0] & 0xf0;
+	learn_entry src;
+	src.ch = msg[0] & 0x0f;
+	int value = 0;          // 0-127
+	bool on = false;        // button-style state
+	switch (type)
+	{
+	case 0x80: src.kind = LS_NOTE; src.num = msg[1]; value = 0; on = false; break;
+	case 0x90: src.kind = LS_NOTE; src.num = msg[1]; value = msg[2]; on = msg[2] != 0; break;
+	case 0xb0: src.kind = LS_CC; src.num = msg[1]; value = msg[2]; on = msg[2] >= 64; break;
+	case 0xd0: src.kind = LS_AT; value = msg[1]; on = msg[1] >= 64; break;
+	case 0xe0: src.kind = LS_PB; value = msg[2]; on = msg[2] >= 80; break;   // MSB only
+	default:   return false;
+	}
+
+	auto found = std::find_if(m_learn_map.begin(), m_learn_map.end(), [&src] (const learn_entry &e) {
+		return e.kind == src.kind && e.ch == src.ch && e.num == src.num; });
+
+	if (m_learn_mode)
+	{
+		if (m_learn_target >= 0 && !(src.kind == LS_NOTE && !on))
+		{
+			int t = m_learn_target;
+			// a knob (CC with in-between values) on a VALUE half turns the whole dial
+			if ((s_learn_targets[t].type == LT_DIAL_DEC || s_learn_targets[t].type == LT_DIAL_INC) &&
+					(src.kind == LS_CC || src.kind == LS_PB || src.kind == LS_AT) && value != 0 && value != 127)
+				for (int i = 0; i < LEARN_TARGETS; i++)
+					if (s_learn_targets[i].type == LT_DIAL)
+						t = i;
+			std::erase_if(m_learn_map, [&src, t] (const learn_entry &e) {
+				return e.target == t || (e.kind == src.kind && e.ch == src.ch && e.num == src.num); });
+			src.target = t;
+			src.last = value;
+			m_learn_map.push_back(src);
+			learn_save();
+			popmessage(m_lang_pl ? "MIDI learn: %s ← %s" : "MIDI learn: %s ← %s", target_name(t), source_name(src));
+			m_learn_target = -1;
+			learn_set_status(3, 1500);
+			return true;
+		}
+		return found != m_learn_map.end();   // assigned controls do nothing while learning
+	}
+
+	if (found == m_learn_map.end())
+		return false;
+
+	learn_entry &e = *found;
+	const learn_target &lt = s_learn_targets[e.target];
+	switch (lt.type)
+	{
+	case LT_BUTTON:
+		if (on)
+			m_midi_keys[lt.port] |= lt.mask;
+		else
+			m_midi_keys[lt.port] &= ~lt.mask;
+		break;
+	case LT_ANALOG:
+	{
+		int const nowa = (src.kind == LS_NOTE) ? (on ? 100 : 0) : (value * 100 + 63) / 127;
+		int const biezaca = analog_value(lt.port);
+		if (!e.przejal)
+		{
+			// Dojazd: galka albo trafila dokladnie w wartosc instrumentu, albo
+			// przeszla przez nia (byla ponizej, jest powyzej lub odwrotnie).
+			if (nowa == biezaca)
+				e.przejal = true;
+			else if (e.ostatnia >= 0 && ((e.ostatnia < biezaca) != (nowa < biezaca)))
+				e.przejal = true;
+			e.ostatnia = nowa;
+			if (!e.przejal)
+				break;              // jeszcze nie dojechala -- instrumentu nie ruszamy
+		}
+		e.ostatnia = nowa;
+		set_analog(lt.port, nowa);
+		break;
+	}
+	case LT_DIAL:
+		if (src.kind != LS_NOTE)
+		{
+			if (e.last >= 0)
+				m_midi_dial += value - e.last;
+			e.last = value;
+		}
+		else if (on)
+			m_midi_dial += 1;
+		break;
+	case LT_DIAL_DEC:
+	case LT_DIAL_INC:
+	{
+		const u8 bit = (lt.type == LT_DIAL_DEC) ? 1 : 2;
+		if (on)
+			m_midi_dial_btn |= bit;
+		else
+			m_midi_dial_btn &= ~bit;
+		break;
+	}
+	}
+	return true;
+}
 
