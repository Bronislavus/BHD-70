+// license:GPL-3.0+
+// copyright-holders:Bronisław Hońca
+/***************************************************************************
+
+    Roland D-70 sound section, see roland_d70_snd.h
+
+    Signal chain as on the MV-30 board (same chips): every 32 kHz frame the
+    LP renders 32 voices, the TVF filters and amplifies them, and the RCC
+    mixes them, adds chorus and reverb and outputs eight 16-bit words.
+    The TVF -> RCC link is serial and four slots deep.
+
+***************************************************************************/
+
+#include "emu.h"
+#include "roland_d70_snd.h"
+#include "bh_d70_shm.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <thread>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// gearmulator chip emulations (unity build: the MAME build only picks up
+// files next to included headers)
+#include "gearmulator/lp/lp.cpp"
+#include "gearmulator/tvf/tvf_emulator.cpp"
+#include "gearmulator/rcc/rcc.cpp"
+#include "gearmulator/rcc/rccBus.cpp"
+
+DEFINE_DEVICE_TYPE(ROLAND_D70_SOUND, roland_d70_sound_device, "roland_d70_snd", "Roland D-70 sound (LP/TVF/RCC)")
+
+namespace {
+
+// sign-extend a chip bus word to the 18-bit signed sample of the next chip
+s32 bus_tap(s32 sample, unsigned sign_bit)
+{
+	u32 const bus = u32(sample);
+	u32 const word = ((bus >> 1) & 0x1ffff) | (((bus >> sign_bit) & 1) << 17);
+	return s32(word) - ((word & 0x20000) ? 0x40000 : 0);
+}
+
+} // anonymous namespace
+
+roland_d70_sound_device::roland_d70_sound_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock)
+	: device_t(mconfig, ROLAND_D70_SOUND, tag, owner, clock)
+	, device_sound_interface(mconfig, *this)
+	, m_int_cb(*this)
+{
+}
+
+roland_d70_sound_device::~roland_d70_sound_device()
+{
+	if (m_pull_thread)
+	{
+		m_pull_stop = true;
+		pull_enable(0);
+		if (m_pull_thread->joinable())
+			m_pull_thread->join();
+	}
+}
+
+void roland_d70_sound_device::device_start()
+{
+	// the LP keeps a reference to m_waves; it is filled at reset, because
+	// the driver descrambles the wave ROMs only after the devices start
+	m_lp = std::make_unique<lpLib::LP>(m_waves);
+	m_lp->setInterruptCallback([this](bool level) { m_int_cb(level ? ASSERT_LINE : CLEAR_LINE); });
+	m_tvf = std::make_unique<tvfLib::TVFEmulator>(true);
+	m_rcc = std::make_unique<rccLib::RCC>();
+
+	m_stream = stream_alloc(0, 2, clock() / 512); // 32 kHz
+
+	// wyjscie dla wtyczki AU: pamiec wspoldzielona
+	if (char const *shm = std::getenv("BH_D70_SHM"))
+	{
+		pull_enable(32);           // kolejka nieuzywana w tym trybie, ale musi istniec
+		std::string const nazwa(shm);
+		m_pull_thread = std::make_unique<std::thread>([this, nazwa] { shm_server_thread(nazwa); });
+	}
+	// proba pod wtyczke AU: odbior probek na zadanie plus testowy odbiorca
+	else if (char const *env = std::getenv("BH_D70_PULL"))
+	{
+		u32 const blok = u32(std::max(16, atoi(env)));
+		// dlugosc kolejki = tyle, ile naprawde potrzeba. To ona jest opoznieniem:
+		// emulacja wklada probki, az kolejka sie zapelni, i wtedy czeka na odbiorce.
+		char const *r = std::getenv("BH_D70_PULL_RING");
+		u32 const ring = r ? u32(std::max(32, atoi(r))) : (blok * 2);
+		pull_enable(ring);
+		std::fprintf(stderr, "BH pull: odbior na zadanie wlaczony, blok %u ramek, kolejka %u ramek (%.2f ms)\n", blok, ring, ring * 1000.0 / 32000.0);
+		std::fflush(stderr);
+		m_pull_thread = std::make_unique<std::thread>([this, blok] { pull_test_thread(blok); });
+	}
+}
+
+void roland_d70_sound_device::device_reset()
+{
+	if (m_waves.empty() && m_wave_src)
+		m_waves.assign(m_wave_src, m_wave_src + m_wave_size);
+	m_lp->reset();
+	m_tvf->reset();
+	m_rcc->reset();
+	std::fill(std::begin(m_serial_delay), std::end(m_serial_delay), 0);
+	std::fill(std::begin(m_slot_peak), std::end(m_slot_peak), 0.0);
+}
+
+u8 roland_d70_sound_device::lp_r(offs_t offset)
+{
+	if (!machine().side_effects_disabled())
+		m_stream->update();
+	return m_lp->read(offset);
+}
+
+void roland_d70_sound_device::lp_w(offs_t offset, u8 data)
+{
+	m_stream->update();
+	m_lp->write(offset, data);
+}
+
+u8 roland_d70_sound_device::tvf_r(offs_t offset)
+{
+	if (!machine().side_effects_disabled())
+		m_stream->update();
+	return m_tvf->read(offset);
+}
+
+void roland_d70_sound_device::tvf_w(offs_t offset, u8 data)
+{
+	m_stream->update();
+	m_tvf->write(offset, data);
+}
+
+u8 roland_d70_sound_device::rcc_r(offs_t offset)
+{
+	if (!machine().side_effects_disabled())
+		m_stream->update();
+	return m_rcc->read(offset);
+}
+
+void roland_d70_sound_device::rcc_w(offs_t offset, u8 data)
+{
+	m_stream->update();
+	m_rcc->write(offset, data);
+}
+
+// --- odbior probek na zadanie (proba pod wtyczke AU) ------------------------
+
+// Serwer dla wtyczki AU: oddaje probki przez pamiec wspoldzielona. Gdy pierscien
+// jest pelny, czekamy -- i wtedy tempo emulacji wyznacza wtyczka (gospodarz/DAW).
+void roland_d70_sound_device::shm_server_thread(std::string nazwa)
+{
+	// Dwie drogi: zwykly plik odwzorowany w pamieci (nazwa zaczyna sie od kropki
+	// lub zawiera ukosnik w srodku -- tak robi wtyczka, bo w piaskownicy katalog
+	// grupy aplikacji jest jedynym wspolnym miejscem), albo nazwany segment POSIX.
+	bool const plikiem = (nazwa.find('/', 1) != std::string::npos);
+	int fd;
+	if (plikiem)
+	{
+		fd = ::open(nazwa.c_str(), O_CREAT | O_RDWR, 0600);
+		if (fd >= 0 && ::ftruncate(fd, sizeof(bh_d70::shm_block)) != 0)
+		{
+			::close(fd);
+			fd = -1;
+		}
+	}
+	else
+	{
+		// Na macOS rozmiar segmentu da sie ustawic tylko raz, zaraz po utworzeniu,
+		// a segment zostaje w systemie po zamknieciu programu -- wiec najpierw
+		// usuwamy ewentualny stary.
+		::shm_unlink(nazwa.c_str());
+		fd = ::shm_open(nazwa.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+		if (fd >= 0 && ::ftruncate(fd, sizeof(bh_d70::shm_block)) != 0)
+		{
+			::close(fd);
+			fd = -1;
+		}
+	}
+	if (fd < 0)
+	{
+		std::fprintf(stderr, "BH shm: nie moge otworzyc %s\n", nazwa.c_str());
+		std::fflush(stderr);
+		return;
+	}
+	void *mem = ::mmap(nullptr, sizeof(bh_d70::shm_block), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	::close(fd);
+	if (mem == MAP_FAILED)
+	{
+		std::fprintf(stderr, "BH shm: mmap nie powiodl sie\n");
+		std::fflush(stderr);
+		return;
+	}
+	auto *b = static_cast<bh_d70::shm_block *>(mem);
+	b->magic = bh_d70::SHM_MAGIC;
+	b->version = bh_d70::SHM_VERSION;
+	b->rate = 32000;
+	b->ring_frames = bh_d70::SHM_RING_FRAMES;
+	b->write_pos.store(0);
+	b->read_pos.store(0);
+	b->underruns.store(0);
+	b->emu_alive.store(1);
+	std::fprintf(stderr, "BH shm: %s gotowe (%u ramek, %u Hz)\n",
+			nazwa.c_str(), b->ring_frames, b->rate);
+	std::fflush(stderr);
+
+	m_shm = b;
+	// Zabezpieczenie przed porzuconym emulatorem. Konczymy w dwoch wypadkach:
+	//   1. wtyczka zeruje host_alive -- jawna prosba o zakonczenie (wtedy MAME
+	//      zdazy zapisac pamiec brzmien);
+	//   2. znikl proces wtyczki, ktory nas uruchomil -- wtedy system przepisuje
+	//      nas na launchd i getppid() daje 1.
+	//
+	// NIE konczymy dlatego, ze odbiorca przestal pobierac dzwiek. Tak bylo wczesniej
+	// (15 s bezruchu) i w DAW-ie uderzalo w niewinnego: Logic przestaje renderowac
+	// instancje, ktorej akurat nie slychac -- na przyklad gdy otworzysz okno innej
+	// wtyczki -- a po 15 s instrument byl juz martwy i milczal do konca sesji.
+	// Ableton pobiera dzwiek bez przerwy, dlatego tam problemu nie bylo.
+	pid_t const rodzic = ::getppid();
+	bool byl_odbiorca = false;
+	bool poproszono = false;
+	while (!m_pull_stop)
+	{
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+		if (b->host_alive.load())
+			byl_odbiorca = true;
+		else if (byl_odbiorca)
+		{
+			std::fprintf(stderr, "BH shm: wtyczka prosi o zakonczenie, zamykam emulator\n");
+			std::fflush(stderr);
+			poproszono = true;
+			m_zamknij = true;
+			break;
+		}
+		if (::getppid() != rodzic)
+		{
+			std::fprintf(stderr, "BH shm: proces wtyczki zniknal, zamykam emulator\n");
+			std::fflush(stderr);
+			poproszono = true;
+			m_zamknij = true;
+			break;
+		}
+	}
+
+	b->emu_alive.store(0);
+	if (!plikiem)
+		::shm_unlink(nazwa.c_str());   // sama nazwa; odwzorowanie zyje dalej
+
+	// UWAGA: gdy to my prosimy o zakonczenie, emulacja trwa jeszcze przez biezacy
+	// kawalek czasu i nadal pisze probki do tego bloku. Odmapowanie go teraz
+	// konczylo sie uzyciem po munmap (SIGSEGV) i pamiec brzmien nigdy sie nie
+	// zapisywala. Zostawiamy odwzorowanie -- proces zaraz sie konczy, a system
+	// zwolni je sam. Sprzatamy tylko wtedy, gdy watek konczy sie na zadanie
+	// emulatora (m_pull_stop), czyli juz po zatrzymaniu maszyny.
+	if (!poproszono)
+	{
+		m_shm = nullptr;
+		::munmap(mem, sizeof(bh_d70::shm_block));
+	}
+
+	std::fprintf(stderr, "BH shm: koniec\n");
+	std::fflush(stderr);
+}
+
+// Testowy odbiorca: co blok prosi uklad o dokladnie `blok` ramek, w tempie czasu
+// rzeczywistego -- tak jak zrobi to gospodarz wtyczki. Pisze na stderr, bo dziennik
+// MAME nie jest bezpieczny z innego watku.
+void roland_d70_sound_device::pull_test_thread(u32 blok)
+{
+	double const rate = 32000.0;
+	std::vector<s16> buf(size_t(blok) * 2);
+	char const *sciezka = std::getenv("BH_D70_PULL_WAV");
+	std::ofstream wav(sciezka ? sciezka : "/tmp/bh-pull.wav", std::ios::binary);
+	char hdr[44] = {0};
+	wav.write(hdr, 44);
+	u64 ramek = 0, brakow = 0, niedobor = 0, bloki = 0;
+	u32 kolejka_max = 0;
+	auto const start = std::chrono::steady_clock::now();
+	auto nastepny = start;
+	auto raport = start;
+	while (!m_pull_stop)
+	{
+		nastepny += std::chrono::microseconds(u64(1000000.0 * blok / rate));
+		std::this_thread::sleep_until(nastepny);
+		u32 const got = pull(buf.data(), blok, 50);
+		bloki++;
+		ramek += got;
+		if (got < blok)
+		{
+			brakow++;
+			niedobor += (blok - got);
+			std::fill(buf.begin() + size_t(got) * 2, buf.end(), s16(0));
+		}
+		kolejka_max = std::max(kolejka_max, pull_queued());
+		wav.write(reinterpret_cast<char const *>(buf.data()), std::streamsize(buf.size() * 2));
+		auto const teraz = std::chrono::steady_clock::now();
+		if (teraz - raport >= std::chrono::seconds(2))
+		{
+			raport = teraz;
+			double const sek = std::chrono::duration<double>(teraz - start).count();
+			std::fprintf(stderr, "BH pull: %llu ramek w %.1f s (%.3f x czasu rzecz.), blokow %llu, "
+					"brakow %llu (%llu ramek), kolejka max %u, czekan emulacji %u\n",
+					(unsigned long long)ramek, sek, ramek / rate / sek,
+					(unsigned long long)bloki, (unsigned long long)brakow,
+					(unsigned long long)niedobor, kolejka_max, m_pull_waits);
+			std::fflush(stderr);
+		}
+	}
+	u32 const dane = u32(ramek * 4);
+	auto put32 = [&](char *q, u32 v) { q[0] = char(v); q[1] = char(v >> 8); q[2] = char(v >> 16); q[3] = char(v >> 24); };
+	auto put16 = [&](char *q, u16 v) { q[0] = char(v); q[1] = char(v >> 8); };
+	std::memcpy(hdr, "RIFF", 4); put32(hdr + 4, 36 + dane);
+	std::memcpy(hdr + 8, "WAVEfmt ", 8); put32(hdr + 16, 16);
+	put16(hdr + 20, 1); put16(hdr + 22, 2); put32(hdr + 24, u32(rate));
+	put32(hdr + 28, u32(rate) * 4); put16(hdr + 32, 4); put16(hdr + 34, 16);
+	std::memcpy(hdr + 36, "data", 4); put32(hdr + 40, dane);
+	wav.seekp(0); wav.write(hdr, 44); wav.close();
+	std::fprintf(stderr, "BH pull: koniec, %llu ramek, brakow %llu\n",
+			(unsigned long long)ramek, (unsigned long long)brakow);
+	std::fflush(stderr);
+}
+
+
+void roland_d70_sound_device::pull_enable(u32 frames)
+{
+	std::unique_lock<std::mutex> lock(m_pull_mutex);
+	m_pull_size = frames;
+	m_pull_buf.assign(size_t(frames) * 2, 0);
+	m_pull_read = m_pull_write = 0;
+	m_pull_waits = 0;
+	m_pull_on = (frames != 0);
+}
+
+u32 roland_d70_sound_device::pull_queued() const
+{
+	std::unique_lock<std::mutex> lock(m_pull_mutex);
+	return (m_pull_write >= m_pull_read) ? (m_pull_write - m_pull_read)
+	                                     : (m_pull_size - m_pull_read + m_pull_write);
+}
+
+// wywolywane z wnetrza generowania dzwieku: czeka, gdy kolejka pelna
+void roland_d70_sound_device::pull_push(s16 l, s16 r)
+{
+	// Droga dla wtyczki AU: piszemy wprost do pamieci wspoldzielonej, bez muteksu.
+	// Gdy stoi w niej wiecej, niz wtyczka chce trzymac w zapasie, czekamy -- i to
+	// jest moment, w ktorym gospodarz (DAW) narzuca emulacji tempo.
+	if (m_shm)
+	{
+		auto *b = static_cast<bh_d70::shm_block *>(m_shm);
+		u32 cel = b->target_frames.load(std::memory_order_relaxed);
+		if (!cel || cel > bh_d70::SHM_MAX_TARGET)
+			cel = 128;
+		if (m_zamknij)
+			return;                      // konczymy: nie ma po co czekac ani pisac
+		if (bh_d70::shm_queued(b) > cel)
+		{
+			// Czekamy tylko, dopoki czekanie ma sens. Gdy odbiorca zamilkl,
+			// pierwsze probowanie trwa 100 ms, a nastepne juz nie czekaja --
+			// inaczej kazda probka kosztowalaby osobne zawieszenie i emulacja
+			// nie reagowalaby ani na sygnal, ani na prosbe o zakonczenie.
+			unsigned krokow = 0;
+			while (!m_czekanie_bez_skutku && !m_pull_stop && !m_zamknij && bh_d70::shm_queued(b) > cel)
+			{
+				if (++krokow > 200)      // ~100 ms
+				{
+					m_czekanie_bez_skutku = true;
+					break;
+				}
+				std::this_thread::sleep_for(std::chrono::microseconds(500));
+			}
+		}
+		else
+			m_czekanie_bez_skutku = false;
+		if (bh_d70::shm_space(b) == 0)
+			return;
+		u32 const w = b->write_pos.load(std::memory_order_relaxed);
+		b->ring[size_t(w) * 2 + 0] = l;
+		b->ring[size_t(w) * 2 + 1] = r;
+		b->write_pos.store((w + 1) % b->ring_frames, std::memory_order_release);
+		return;
+	}
+
+	std::unique_lock<std::mutex> lock(m_pull_mutex);
+	u32 next = (m_pull_write + 1) % m_pull_size;
+	if (next == m_pull_read)
+	{
+		m_pull_waits++;
+		m_pull_space.wait_for(lock, std::chrono::milliseconds(200),
+				[&] { return ((m_pull_write + 1) % m_pull_size) != m_pull_read || !m_pull_on; });
+		next = (m_pull_write + 1) % m_pull_size;
+		if (next == m_pull_read)
+			return;                     // odbiorca zamilkl -- nie blokujemy emulacji na zawsze
+	}
+	m_pull_buf[size_t(m_pull_write) * 2 + 0] = l;
+	m_pull_buf[size_t(m_pull_write) * 2 + 1] = r;
+	m_pull_write = next;
+	m_pull_data.notify_one();
+}
+
+// wywolywane przez odbiorce (w wtyczce: z watku audio gospodarza)
+u32 roland_d70_sound_device::pull(s16 *dst, u32 frames, u32 wait_ms)
+{
+	std::unique_lock<std::mutex> lock(m_pull_mutex);
+	u32 oddane = 0;
+	while (oddane < frames)
+	{
+		if (m_pull_read == m_pull_write)
+		{
+			if (!m_pull_data.wait_for(lock, std::chrono::milliseconds(wait_ms),
+					[&] { return m_pull_read != m_pull_write; }))
+				break;                  // emulacja nie nadazyla
+		}
+		dst[size_t(oddane) * 2 + 0] = m_pull_buf[size_t(m_pull_read) * 2 + 0];
+		dst[size_t(oddane) * 2 + 1] = m_pull_buf[size_t(m_pull_read) * 2 + 1];
+		m_pull_read = (m_pull_read + 1) % m_pull_size;
+		oddane++;
+	}
+	m_pull_space.notify_all();
+	return oddane;
+}
+
+void roland_d70_sound_device::sound_stream_update(sound_stream &stream)
+{
+	// Watek shm poprosil o zakonczenie. Flagi nie kasujemy -- dzieki temu
+	// pull_push wie, ze nie ma juz na co czekac, i emulacja dochodzi do konca
+	// biezacego kawalka czasu od razu (MAME zapisuje wtedy pamiec brzmien).
+	if (m_zamknij && !m_wyjscie_zlecone)
+	{
+		m_wyjscie_zlecone = true;
+		machine().schedule_exit();
+	}
+
+	for (int s = 0; s < stream.samples(); s++)
+	{
+		auto const voices = m_lp->renderSample();
+		std::array<int32_t, lpLib::LP::VoiceCount> tvf_in{};
+		std::array<int32_t, lpLib::LP::VoiceCount> tvf_out{};
+		for (size_t v = 0; v < voices.size(); v++)
+			tvf_in[v] = bus_tap(voices[v], 21);
+		m_tvf->processFrame<lpLib::LP::VoiceCount>(tvf_in.data(), tvf_out.data());
+
+		rccLib::RCC::Voices rcc_in{};
+		for (size_t v = 0; v < rcc_in.size(); v++)
+			rcc_in[v] = std::exchange(m_serial_delay[v & 3], bus_tap(tvf_out[v], 23));
+
+		auto const out = m_rcc->processFrame(rcc_in);
