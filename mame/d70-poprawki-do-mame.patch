+// splits the live byte stream into messages for m_filter (handles running status)
+void midiin_device::filter_byte(uint8_t data)
+{
+	if (data >= 0xf8)
+	{
+		xmit_char(data);            // real-time bytes go straight through
+		return;
+	}
+	if (data >= 0x80)
+	{
+		m_flt_len = 0;
+		if (data == 0xf0)
+		{
+			m_flt_sysex = true;
+			m_flt_status = 0;
+			xmit_char(data);
+			return;
+		}
+		if (data >= 0xf0)
+		{
+			// end of SysEx and system common messages pass unchanged, cancel running status
+			m_flt_sysex = false;
+			m_flt_status = 0;
+			xmit_char(data);
+			return;
+		}
+		m_flt_sysex = false;
+		m_flt_status = data;
+		m_flt_msg[m_flt_len++] = data;
+		if ((data & 0xf0) == 0xc0 || (data & 0xf0) == 0xd0)
+			return;                 // wait for the single data byte
+		return;
+	}
+
+	// data byte
+	if (m_flt_sysex || !m_flt_status)
+	{
+		xmit_char(data);
+		return;
+	}
+	if (m_flt_len == 0)
+		m_flt_msg[m_flt_len++] = m_flt_status;  // running status
+	m_flt_msg[m_flt_len++] = data;
+	const int need = ((m_flt_status & 0xf0) == 0xc0 || (m_flt_status & 0xf0) == 0xd0) ? 2 : 3;
+	if (m_flt_len < need)
+		return;
+	if (!m_filter(m_flt_msg, need))
+		for (int i = 0; i < need; i++)
+			xmit_char(m_flt_msg[i]);
+	m_flt_len = 0;
+}
