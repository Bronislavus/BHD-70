+// Several inputs merged into one, e.g. a DAW's virtual port and a hardware
+// keyboard ("virtual:Roland D-70|M4"). Each read returns whole messages from
+// one source; a source that started a SysEx keeps the port until EOX.
+class midi_input_multi : public midi_input_port
+{
+public:
+	midi_input_multi(std::vector<std::unique_ptr<midi_input_port>> &&ports) : m_ports(std::move(ports)) { }
+
+	virtual bool poll() override
+	{
+		if (m_sysex_owner >= 0)
+			return m_ports[m_sysex_owner]->poll();
+		for (auto &port : m_ports)
+			if (port->poll())
+				return true;
+		return false;
+	}
+
+	virtual int read(uint8_t *pOut) override
+	{
+		size_t const count = m_ports.size();
+		for (size_t n = 0; n < count; n++)
+		{
+			size_t const i = (m_sysex_owner >= 0) ? size_t(m_sysex_owner) : (m_next + n) % count;
+			if (!m_ports[i]->poll())
+			{
+				if (m_sysex_owner >= 0)
+					return 0;
+				continue;
+			}
+			int const bytes = m_ports[i]->read(pOut);
+			for (int b = 0; b < bytes; b++)
+			{
+				if (pOut[b] == MIDI_SYSEX)
+					m_sysex_owner = int(i);
+				else if (pOut[b] == MIDI_EOX)
+					m_sysex_owner = -1;
+			}
+			m_next = (i + 1) % count;
+			return bytes;
+		}
+		return 0;
+	}
+
+private:
+	std::vector<std::unique_ptr<midi_input_port>> m_ports;
+	int m_sysex_owner = -1;
+	size_t m_next = 0;
+};
