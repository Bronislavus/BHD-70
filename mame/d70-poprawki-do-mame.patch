@@ -0,0 +1,68 @@
+#!/bin/bash
+# Uniezależnia program ./d70 od /opt/homebrew.
+#
+# Po co: wtyczka AU uruchamia emulator jako swój proces potomny, a ten dziedziczy
+# piaskownicę gospodarza (Logic). Piaskownica nie wpuszcza do /opt/homebrew, więc
+# emulator nie mógł wczytać biblioteki SDL i ginął zaraz po starcie. Kopiujemy
+# potrzebne biblioteki do ./lib i przestawiamy program na nie.
+#
+# Uruchamiać po każdym `make` (robi to za nas BHD70AU/build.sh).
+# Skrypt jest odporny na powtórzenia: działa i wtedy, gdy program już wskazuje
+# na ./lib, ale plików tam brakuje.
+
+set -e
+cd "$(dirname "$0")"
+[ -x ./d70 ] || { echo "brak ./d70 -- najpierw zbuduj emulator" >&2; exit 1; }
+mkdir -p lib
+
+# gdzie szukać oryginału biblioteki, gdy brakuje jej w ./lib
+znajdz_zrodlo() {
+	local nazwa="$1"
+	local k
+	for k in /opt/homebrew/lib /usr/local/lib; do
+		[ -f "$k/$nazwa" ] && { echo "$k/$nazwa"; return 0; }
+	done
+	for k in /opt/homebrew/opt/*/lib /usr/local/opt/*/lib; do
+		[ -f "$k/$nazwa" ] && { echo "$k/$nazwa"; return 0; }
+	done
+	return 1
+}
+
+zmiany=0
+while read -r odwolanie; do
+	[ -z "$odwolanie" ] && continue
+	nazwa="$(basename "$odwolanie")"
+
+	if [ ! -f "lib/$nazwa" ]; then
+		zrodlo="$odwolanie"
+		case "$odwolanie" in
+			@loader_path/*) zrodlo="$(znajdz_zrodlo "$nazwa")" || {
+				echo "UWAGA: nie znajduję oryginału $nazwa" >&2; exit 1; } ;;
+		esac
+		cp -f "$zrodlo" "lib/$nazwa"
+		chmod u+w "lib/$nazwa"
+		install_name_tool -id "@loader_path/lib/$nazwa" "lib/$nazwa"
+		# każda zmiana w pliku unieważnia podpis, a system nie uruchomi niepodpisanego
+		codesign --force --sign - "lib/$nazwa"
+		echo "  skopiowane: $nazwa"
+		zmiany=$((zmiany + 1))
+	fi
+
+	case "$odwolanie" in
+		@loader_path/*) ;;
+		*) install_name_tool -change "$odwolanie" "@loader_path/lib/$nazwa" ./d70
+		   echo "  przestawione: $nazwa"
+		   zmiany=$((zmiany + 1)) ;;
+	esac
+done < <(otool -L ./d70 | awk '/\/opt\/homebrew|\/usr\/local\/(opt|lib)|@loader_path\/lib\// { print $1 }')
+
+if [ "$zmiany" -gt 0 ]; then
+	codesign --force --sign - ./d70
+	echo "emulator uniezależniony od /opt/homebrew"
+else
+	echo "emulator już niezależny, nic do zrobienia"
+fi
+
+otool -L ./d70 | grep -qE '/opt/homebrew|/usr/local/(opt|lib)' && {
+	echo "UWAGA: zostały odwołania do /opt/homebrew" >&2; exit 1; }
+exit 0
