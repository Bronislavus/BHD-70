+
+std::string roland_d70_state::source_name(const learn_entry &e)
+{
+	const char *ch = m_lang_pl ? "kanał" : "channel";
+	switch (e.kind)
+	{
+	case LS_CC:   return util::string_format("CC %d (%s %d)", e.num, ch, e.ch + 1);
+	case LS_NOTE: return util::string_format(m_lang_pl ? "nuta %d (%s %d)" : "note %d (%s %d)", e.num, ch, e.ch + 1);
+	case LS_PB:   return util::string_format("Pitch Bend (%s %d)", ch, e.ch + 1);
+	case LS_AT:   return util::string_format("Aftertouch (%s %d)", ch, e.ch + 1);
