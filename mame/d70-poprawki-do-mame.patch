+// ---------------------------------------------------------------------------
+// BH: panel wtyczki
+//
+// Emulator nie rysuje juz wlasnego okna -- obraz ekranu, stan diod i
+// nacisniecia przechodza przez wspolny blok pamieci. Dzieki temu panel
+// BHD-70 jest prawdziwym panelem D-70, tylko narysowanym po naszemu.
+// ---------------------------------------------------------------------------
+
+bh_d70::shm_block *roland_d70_state::bh_blok() {
+	auto *b = m_snd->bh_blok();
+	return (b && b->version >= 2) ? b : nullptr;
+}
+
+u32 roland_d70_state::ekran_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect) {
+	u32 const wynik = m_lcd->screen_update(screen, bitmap, cliprect);
+
+	++m_ekran_klatka;
+	// Podglad: wypisuje, gdy obraz ekranu sie zmienil (BH_EKRAN=1)
+	if (getenv("BH_EKRAN") && (m_ekran_klatka % 8) == 0) {
+		u32 h = 2166136261u;
+		for (u32 y = 0; y < bh_d70::EKRAN_WYS; y++) {
+			u16 const *w = &bitmap.pix(int(y), 0);
+			for (u32 x = 0; x < bh_d70::EKRAN_SZER; x++) h = (h ^ u32(w[x] ? 1 : 0)) * 16777619u;
+		}
+		if (h != m_diag_hash) {
+			m_diag_hash = h;
+			std::fprintf(stderr, "BH ekran: zmiana o %.2f s\n", machine().time().as_double());
+			std::fflush(stderr);
+		}
+	}
+
+	if (getenv("BH_SKAN") && (m_ekran_klatka % 500) == 0) {
+		std::fprintf(stderr, "BH skan: enc %u, banki", m_diag_enc);
+		for (int i = 0; i < 10; i++) std::fprintf(stderr, " %u", m_diag_bank[i]);
+		std::fprintf(stderr, "\n");
+		std::fflush(stderr);
+	}
+
+	// Podglad strumienia do panelu (BH_DIODY=1) -- przydaje sie, gdy firmware
+	// zmieni sposob wysylania diod.
+	if (getenv("BH_DIODY") && (m_ekran_klatka % 256) == 0)
+		std::fprintf(stderr, "BH diody: bitow %u, paczka %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				m_led_bitow, m_led_surowe[0], m_led_surowe[1], m_led_surowe[2], m_led_surowe[3],
+				m_led_surowe[4], m_led_surowe[5], m_led_surowe[6], m_led_surowe[7]);
+
+	// Ekran liczymy 250 razy na sekunde (przez dzwiek), a oddajemy co osma
+	// klatke -- nieco ponad 30 razy na sekunde wystarczy oku.
+	if (m_ekran_klatka % 8)
+		return wynik;
+
+	auto *b = bh_blok();
+	if (!b)
+		return wynik;
+
+	for (u32 y = 0; y < bh_d70::EKRAN_WYS; y++) {
+		u16 const *wiersz = &bitmap.pix(int(y), 0);
+		for (u32 x = 0; x < bh_d70::EKRAN_SZER; x += 8) {
+			u8 bajt = 0;
+			for (u32 k = 0; k < 8; k++)
+				if (wiersz[x + k])
+					bajt |= u8(1 << k);
+			b->ekran[(y * bh_d70::EKRAN_SZER + x) / 8] = bajt;
+		}
+	}
+	b->diody.store(u32(m_leds[0]) | (u32(m_leds[1]) << 8) | (u32(m_leds[2]) << 16) | (u32(m_leds[3]) << 24),
+			std::memory_order_relaxed);
+	b->dioda_learn.store(m_learn_led ? 1 : 0, std::memory_order_relaxed);
+	u32 cel = 0;
+	if (m_learn_mode && m_learn_target >= 0 && m_learn_target < LEARN_TARGETS) {
+		const learn_target &lt = s_learn_targets[m_learn_target];
+		u32 const rodzaj = (lt.type == LT_BUTTON) ? 1u : (lt.type == LT_ANALOG) ? 2u
+				: (lt.type == LT_DIAL) ? 3u : (lt.type == LT_DIAL_DEC) ? 4u : 5u;
+		cel = (rodzaj << 24) | (u32(lt.port) << 16) | (u32(lt.mask) << 8);
+	}
+	b->learn_cel.store(cel, std::memory_order_relaxed);
+
+	// Co jest wcisniete i gdzie stoja suwaki -- zeby panel wtyczki pokazywal zmiany
+	// zrobione kontrolerem przez MIDI learn, a nie tylko te zrobione mysza.
+	u32 wcis[2] = { 0, 0 };
+	for (int p = 0; p < 8; p++)
+	{
+		u8 const stan = u8(~m_keys[p]->read() | m_midi_keys[p] | m_bh_keys[p]);
+		wcis[p / 4] |= u32(stan) << ((p % 4) * 8);
+	}
+	b->przyciski_lo.store(wcis[0], std::memory_order_relaxed);
+	b->przyciski_hi.store(wcis[1], std::memory_order_relaxed);
+	u32 suw[2] = { 0, 0 };
+	for (int i = 0; i < 8; i++)
+	{
+		u8 const v = u8(std::clamp(analog_value(i), 0, 100));
+		suw[i / 4] |= u32(v) << ((i % 4) * 8);
+	}
+	b->suwaki_lo.store(suw[0], std::memory_order_relaxed);
+	b->suwaki_hi.store(suw[1], std::memory_order_relaxed);
+	b->ekran_licznik.fetch_add(1, std::memory_order_release);
+	return wynik;
+}
+
+TIMER_DEVICE_CALLBACK_MEMBER(roland_d70_state::bh_panel_timer_cb) {
+	// najpierw doliczamy czas trzymania tego, co juz wcisniete
+	for (int p = 0; p < 8; p++)
+		bh_odliczaj(m_bh_keys[p], m_bh_keys_chce[p], m_bh_keys_tik[p], 8);
+	bh_odliczaj(m_bh_learn, m_bh_learn_chce, m_bh_learn_tik, 8);
+	bh_odliczaj(m_bh_btn, m_bh_btn_chce, m_bh_btn_tik, 2);
+
+	auto *b = bh_blok();
+	if (!b)
+		return;
+
+	u32 czyt = b->rozkaz_czytaj.load(std::memory_order_relaxed);
+	u32 const pisz = b->rozkaz_pisz.load(std::memory_order_acquire);
+	while (czyt != pisz) {
+		u32 const r = b->rozkazy[czyt % bh_d70::ROZKAZOW];
+		czyt = (czyt + 1) % bh_d70::ROZKAZOW;
+		u8 const rodzaj = u8(r >> 24), a = u8(r >> 16), bb = u8(r >> 8), c = u8(r);
+		switch (rodzaj) {
+		case bh_d70::ROZKAZ_PRZYCISK:
+			if (a < 8 && bb < 8)
+				bh_trzymaj(m_bh_keys[a], m_bh_keys_chce[a], m_bh_keys_tik[a], bb, c != 0);
+			break;
+		case bh_d70::ROZKAZ_SUWAK:
+			if (a < 8)
+			{
+				set_analog(a, std::min<int>(bb, 100));
+				// Suwak przestawiony mysza: przypisana galka musi do niego dojechac
+				// od nowa, inaczej skoczylby z powrotem przy pierwszym ruchu.
+				for (learn_entry &w : m_learn_map)
+					if (w.target >= 0 && w.target < LEARN_TARGETS
+					    && s_learn_targets[w.target].type == LT_ANALOG
+					    && s_learn_targets[w.target].port == a)
+						w.przejal = false;
+			}
+			break;
+		case bh_d70::ROZKAZ_POKRETLO:
+			m_midi_dial += int(a) - int(bb);
+			break;
+		case bh_d70::ROZKAZ_LEARN:
+			if (a < 8)
+				bh_trzymaj(m_bh_learn, m_bh_learn_chce, m_bh_learn_tik, a, c != 0);
+			break;
+		case bh_d70::ROZKAZ_POLOWKA:
+			bh_trzymaj(m_bh_btn, m_bh_btn_chce, m_bh_btn_tik, a ? 1 : 0, c != 0);
+			break;
+		default:
+			break;
+		}
+	}
+	b->rozkaz_czytaj.store(czyt, std::memory_order_release);
+}
