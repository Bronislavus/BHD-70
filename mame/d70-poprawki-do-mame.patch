+void roland_d70_state::set_analog(int i, int value)
+{
+	ioport_field *field = analog_port(i).fields().first();
+	if (!field)
+		return;
+	ioport_field::user_settings settings;
+	field->get_user_settings(settings);
+	settings.value = std::clamp(value, 0, 100);
+	field->set_user_settings(settings);
 }
 
