+			learn_save();
+			popmessage(m_lang_pl ? "MIDI learn: %s – przypisanie usunięte" : "MIDI learn: %s – assignment removed", target_name(t));
+			m_learn_target = -1;
+			learn_set_status(4, 1500);
+		}
+		else
+			popmessage(m_lang_pl ? "MIDI learn: najpierw kliknij element panelu" : "MIDI learn: click a panel control first");
+	}
+
+	if (m_learn_mode)
+	{
+		// which panel element did the user touch?
+		int sel = -1;
+		for (int p = 0; p < 8 && sel < 0; p++)
+		{
+			const u8 cur = u8(~m_keys[p]->read() | m_bh_keys[p]);
+			const u8 down = cur & ~m_learn_keys_prev[p];
+			m_learn_keys_prev[p] = cur;
+			if (down)
+				for (int t = 0; t < LEARN_TARGETS; t++)
+					if (s_learn_targets[t].type == LT_BUTTON && s_learn_targets[t].port == p && (down & s_learn_targets[t].mask))
+					{
+						sel = t;
+						break;
+					}
+		}
+		const u8 vb = m_value_btn->read() | m_bh_btn;
+		const u8 vdown = vb & ~m_learn_valbtn_prev;
+		m_learn_valbtn_prev = vb;
+		const u8 dial = m_value->read();
+		const bool dial_moved = dial != m_learn_dial_prev;
+		m_learn_dial_prev = dial;
+		for (int t = 0; t < LEARN_TARGETS && sel < 0; t++)
+		{
+			const learn_target &lt = s_learn_targets[t];
+			if ((lt.type == LT_DIAL_DEC && BIT(vdown, 0)) || (lt.type == LT_DIAL_INC && BIT(vdown, 1)) || (lt.type == LT_DIAL && dial_moved))
+				sel = t;
+			else if (lt.type == LT_ANALOG && std::abs(analog_value(lt.port) - m_learn_ref[lt.port]) >= 3)
+				sel = t;
+		}
+		if (sel >= 0 && sel != m_learn_target)
+			learn_select(sel);
+		else if (sel >= 0)
+			for (int i = 0; i < LEARN_ANALOGS; i++)
+				m_learn_ref[i] = analog_value(i);
+
+		if (m_learn_status >= 3 && machine().time() >= m_learn_status_until)
+			learn_set_status(m_learn_target >= 0 ? 2 : 1, 0);
+	}
+
+	// LED: blinks while waiting for a controller, steady in learn mode
+	m_learn_led = m_learn_mode ? ((m_learn_target >= 0) ? BIT(++m_learn_ticks, 4) : 1) : 0;
+
+	// the map file was changed from outside (BH D-70 window) -> read it again
+	if (!m_learn_mode && (++m_learn_ticks % 100) == 0)
+	{
+		std::error_code ec;
+		auto mtime = std::filesystem::last_write_time(m_learn_path, ec);
+		if (ec)
+		{
+			if (!m_learn_map.empty())
+				learn_load();   // file removed -> no assignments
+		}
+		else if (mtime != m_learn_mtime)
+		{
+			learn_load();
+			popmessage(m_lang_pl ? "MIDI learn: wczytano mapę (%d przypisań)" : "MIDI learn: map loaded (%d assignments)", int(m_learn_map.size()));
+		}
+	}
+}
