+}
+
+void roland_d70_state::learn_load()
+{
+	m_learn_map.clear();
+	std::memset(m_midi_keys, 0, sizeof(m_midi_keys));
+	m_midi_dial_btn = 0;
+	std::error_code ec;
+	m_learn_mtime = std::filesystem::last_write_time(m_learn_path, ec);
+	std::ifstream in(m_learn_path);
+	std::string line;
+	while (std::getline(in, line))
+	{
+		if (line.empty() || line[0] == '#')
+			continue;
+		std::istringstream ls(line);
+		std::string id, kind;
+		int ch = 0, num = 0;
+		if (!(ls >> id >> kind >> ch))
+			continue;
+		ls >> num;
+		learn_entry e;
+		for (int k = LS_CC; k <= LS_AT; k++)
+			if (kind == s_learn_kind_names[k])
+				e.kind = k;
+		for (int t = 0; t < LEARN_TARGETS; t++)
+			if (id == s_learn_targets[t].id)
+				e.target = t;
+		if (e.kind == LS_NONE || e.target < 0 || ch < 1 || ch > 16 || num < 0 || num > 127)
+			continue;
+		e.ch = ch - 1;
+		e.num = (e.kind == LS_CC || e.kind == LS_NOTE) ? num : 0;
+		m_learn_map.push_back(e);
+	}
+	osd_printf_verbose("D-70 MIDI learn: %d assignments from %s\n", int(m_learn_map.size()), m_learn_path);
+}
+
+void roland_d70_state::learn_save()
+{
+	{
+		std::ofstream out(m_learn_path, std::ios::trunc);
+		if (!out)
+		{
+			osd_printf_error("D-70 MIDI learn: cannot write %s\n", m_learn_path);
+			return;
+		}
+		out << "# BH D-70 MIDI learn: element  cc|note|pb|at  channel(1-16)  number\n";
+		for (const learn_entry &e : m_learn_map)
+			out << s_learn_targets[e.target].id << ' ' << s_learn_kind_names[e.kind] << ' ' << int(e.ch) + 1 << ' ' << int(e.num) << '\n';
+	}
+	std::error_code ec;
+	m_learn_mtime = std::filesystem::last_write_time(m_learn_path, ec);
+}
+
+void roland_d70_state::learn_select(int t)
+{
+	m_learn_target = t;
+	for (int i = 0; i < LEARN_ANALOGS; i++)
+		m_learn_ref[i] = analog_value(i);
+	learn_set_status(2, 0);
+	std::string cur;
+	for (const learn_entry &e : m_learn_map)
+		if (e.target == t)
+			cur = source_name(e);
+	if (m_lang_pl)
+		popmessage("MIDI learn: %s – rusz elementem kontrolera%s%s", target_name(t), cur.empty() ? "" : "\n(teraz: ", cur.empty() ? "" : (cur + ")").c_str());
+	else
+		popmessage("MIDI learn: %s – move a controller%s%s", target_name(t), cur.empty() ? "" : "\n(now: ", cur.empty() ? "" : (cur + ")").c_str());
+}
