+			std::array<uint8_t, 4> chorusPhaseBase{};
+			uint8_t chorusPhaseBaseSample1{};
+			uint8_t chorusPhaseFeedbackSample2{};
+			uint8_t chorusPhaseFeedbackWrite2{};
+			uint8_t chorusPhaseFoldWrite1{};
