+			for (int p = 0; p < 8; p++)
+				m_learn_keys_prev[p] = u8(~m_keys[p]->read() | m_bh_keys[p]);
+			m_learn_valbtn_prev = m_value_btn->read() | m_bh_btn;
+			m_learn_dial_prev = m_value->read();
+			// nothing stays held down from MIDI while learning
+			std::memset(m_midi_keys, 0, sizeof(m_midi_keys));
+			m_midi_dial_btn = 0;
+			m_midi_dial = 0;
+			learn_set_status(1, 0);
+			popmessage(m_lang_pl ? "MIDI learn: kliknij element panelu, potem rusz elementem kontrolera MIDI"
+					: "MIDI learn: click a panel control, then move a control on your MIDI controller");
+		}
+		else
