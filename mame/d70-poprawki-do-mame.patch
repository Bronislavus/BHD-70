+	~roland_d70_sound_device();
+
+	// wave ROMs, already descrambled (address = bank << 18 | offset)
+	void set_wave_rom(const u8 *data, size_t size) { m_wave_src = data; m_wave_size = size; }
+	auto int_callback() { return m_int_cb.bind(); }
+
+	u8 lp_r(offs_t offset);
+	void lp_w(offs_t offset, u8 data);
+	u8 tvf_r(offs_t offset);
+	void tvf_w(offs_t offset, u8 data);
+	u8 rcc_r(offs_t offset);
+	void rcc_w(offs_t offset, u8 data);
+
+	// --- odbior probek na zadanie (proba pod wtyczke AU) ---------------------
+	// W wtyczce gospodarz pyta "daj N probek", a emulacja ma przesunac sie
+	// dokladnie o tyle. Tutaj robimy to najkrocsza droga: uklad wkłada probki
+	// do wlasnej kolejki i **czeka**, gdy jest pelna, a odbiorca je zabiera.
+	// Wtedy tempo emulacji wyznacza odbior, bez porcji, zrywow i zapasu.
+	void pull_enable(u32 frames);                      // 0 = wylaczone
+	bool pull_enabled() const { return m_pull_on; }
+	// zabiera dokladnie `frames` ramek stereo; zwraca ile faktycznie oddala
+	u32 pull(s16 *dst, u32 frames, u32 wait_ms);
+	u32 pull_queued() const;                           // ile ramek czeka
+	u32 pull_waits() const { return m_pull_waits; }    // ile razy emulacja czekala
+
+	// Wspolny blok pamieci z wtyczka (nullptr, gdy emulator chodzi sam).
+	// Panel korzysta z niego, zeby oddac obraz ekranu i diody, a odebrac nacisniecia.
+	bh_d70::shm_block *bh_blok() const { return static_cast<bh_d70::shm_block *>(m_shm); }
+
+	// testowy odbiorca w tempie czasu rzeczywistego (udaje gospodarza/DAW);
+	// wlaczany zmienna srodowiskowa BH_D70_PULL=<ramek na blok>, wynik na stderr
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+	virtual void sound_stream_update(sound_stream &stream) override;
+
+private:
+	devcb_write_line m_int_cb;
+	sound_stream *m_stream = nullptr;
+	const u8 *m_wave_src = nullptr;
+	size_t m_wave_size = 0;
+	std::vector<u8> m_waves;
+	std::unique_ptr<lpLib::LP> m_lp;
+	std::unique_ptr<tvfLib::TVFEmulator> m_tvf;
+	std::unique_ptr<rccLib::RCC> m_rcc;
+	s32 m_serial_delay[4];
+
+	// development aid: level per RCC output slot
+	double m_slot_peak[8];
+	u32 m_frames = 0;
+
+	// kolejka do odbioru na zadanie
+	bool m_pull_on = false;
+	std::vector<s16> m_pull_buf;       // ramki stereo, 2 * m_pull_size probek
+	u32 m_pull_size = 0;               // dlugosc kolejki w ramkach
+	u32 m_pull_read = 0;
+	u32 m_pull_write = 0;
+	u32 m_pull_waits = 0;
+	mutable std::mutex m_pull_mutex;
+	std::condition_variable m_pull_space;   // jest miejsce (dla emulacji)
+	std::condition_variable m_pull_data;    // sa dane (dla odbiorcy)
+	void pull_push(s16 l, s16 r);
+	void pull_test_thread(u32 blok);
+	void shm_server_thread(std::string nazwa);
+	void *m_shm = nullptr;
+	bool m_czekanie_bez_skutku = false;   // odbiorca zamilkl, nie ma na co czekac
+	bool m_wyjscie_zlecone = false;       // schedule_exit juz wolane
+	std::atomic<bool> m_zamknij{false};   // watek shm prosi o zakonczenie emulacji        // bh_d70::shm_block, gdy wtyczka odbiera bezposrednio
+	std::unique_ptr<std::thread> m_pull_thread;
+	bool m_pull_stop = false;
+};
+
+DECLARE_DEVICE_TYPE(ROLAND_D70_SOUND, roland_d70_sound_device)
+
+#endif // MAME_ROLAND_ROLAND_D70_SND_H
