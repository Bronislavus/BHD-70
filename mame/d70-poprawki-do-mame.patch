+// ---------------------------------------------------------------------------
+// MIDI learn
+//
+//  LEARN on the panel -> learn mode: the firmware sees the panel frozen.
+//  Touch a panel element (button, slider, VALUE half) -> it is selected.
+//  Move a controller (CC, note, pitch bend, channel pressure) -> assigned.
+//  CLEAR removes the assignment of the selected element. LEARN again ends.
+//  Assigned messages drive only the panel; they are not passed to the firmware.
+//  The map is a text file (one line per assignment) re-read when it changes.
+// ---------------------------------------------------------------------------
+
+static const char *const s_learn_kind_names[] = { "", "cc", "note", "pb", "at" };
